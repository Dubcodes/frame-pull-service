FRAME_PULL_SOURCE_DIR=J:\frame-pull\trackside_recordings
FRAME_PULL_LEGACY_ENGINE_ROOT=J:\frame-pull
FRAME_PULL_DATA_DIR=J:\projects\frame-pull-service\data
FRAME_PULL_HOST=127.0.0.1
FRAME_PULL_PORT=8094
FRAME_PULL_DISCOVERY_INTERVAL_SECONDS=30
FRAME_PULL_STABLE_FOR_SECONDS=120
FRAME_PULL_MIN_INPUT_BYTES=10485760
FRAME_PULL_AUTO_QUEUE=true
FRAME_PULL_QUEUE_EXISTING_ON_FIRST_RUN=false
FRAME_PULL_MAX_CONCURRENT_JOBS=1
FRAME_PULL_CLIP_PADDING_SECONDS=5
FRAME_PULL_RECORDER_ENABLED=false
# Keep the actual input out of source control. Set this only in a local secret environment file.
# FRAME_PULL_RECORDER_INPUT=
# Use trackside_hls only with locally configured values. The profile adds
# resilient HLS input options, CRLF Origin/Referer headers, and explicit
# program video/audio mapping; it never falls back to -map 0.
FRAME_PULL_RECORDER_PROFILE=generic
# FRAME_PULL_RECORDER_ORIGIN=
# FRAME_PULL_RECORDER_REFERER=
# FRAME_PULL_RECORDER_PROGRAM=
# Bound FFmpeg-level recovery for finite/short HLS playlists. These only apply
# to the trackside_hls profile; no application-level infinite restart loop is used.
FRAME_PULL_RECORDER_RECONNECT_MAX_RETRIES=3
FRAME_PULL_RECORDER_RECONNECT_DELAY_TOTAL_MAX=30
FRAME_PULL_RECORDER_FFMPEG_PATH=ffmpeg
# Defaults to FRAME_PULL_SOURCE_DIR when omitted.
# FRAME_PULL_RECORDER_OUTPUT_DIR=
FRAME_PULL_RECORDER_CHUNK_MINUTES=60
FRAME_PULL_RECORDER_MIN_FREE_SPACE_GB=20
FRAME_PULL_DATABASE_URL=sqlite:///J:/projects/frame-pull-service/data/frame_pull.db
