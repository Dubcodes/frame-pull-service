# Container-internal paths. Host paths used for bind mounts are below.
FRAME_PULL_SOURCE_DIR=/recordings
FRAME_PULL_DATA_DIR=/data
FRAME_PULL_LEGACY_ENGINE_ROOT=/legacy
FRAME_PULL_LEGACY_PYTHON=/usr/local/bin/python
FRAME_PULL_HOST=0.0.0.0
FRAME_PULL_PORT=8094
FRAME_PULL_BROADCAST_TIMEZONE=Pacific/Auckland
FRAME_PULL_DATABASE_URL=sqlite:////data/frame_pull.db

# Compose host bindings. Keep FRAME_PULL_HOST_DATA_DIR on local Linux storage;
# never put the live SQLite database on SMB, NFS, or another network filesystem.
FRAME_PULL_HOST_DATA_DIR=/srv/frame-pull/data
FRAME_PULL_HOST_RECORDINGS_DIR=/srv/frame-pull/recordings
FRAME_PULL_HOST_LEGACY_DIR=/srv/frame-pull/legacy
FRAME_PULL_PUBLISHED_PORT=8094
# Absolute path is useful when Compose runs from a separate source checkout.
FRAME_PULL_ENV_FILE=/srv/frame-pull/.env

FRAME_PULL_DISCOVERY_INTERVAL_SECONDS=30
FRAME_PULL_STABLE_FOR_SECONDS=120
FRAME_PULL_MIN_INPUT_BYTES=10485760
FRAME_PULL_AUTO_QUEUE=false
FRAME_PULL_QUEUE_EXISTING_ON_FIRST_RUN=false
FRAME_PULL_MAX_CONCURRENT_JOBS=1
FRAME_PULL_CLIP_PADDING_SECONDS=5

FRAME_PULL_RECORDER_ENABLED=false
# The current Trackside endpoint is a server-local secret. Never commit it.
# FRAME_PULL_RECORDER_INPUT=
FRAME_PULL_RECORDER_PROFILE=generic
# FRAME_PULL_RECORDER_PROGRAM=
# FRAME_PULL_RECORDER_ORIGIN=
# FRAME_PULL_RECORDER_REFERER=
FRAME_PULL_RECORDER_RECONNECT_MAX_RETRIES=3
FRAME_PULL_RECORDER_RECONNECT_DELAY_TOTAL_MAX=30
FRAME_PULL_RECORDER_FFMPEG_PATH=ffmpeg
# Defaults to FRAME_PULL_SOURCE_DIR when omitted.
# FRAME_PULL_RECORDER_OUTPUT_DIR=
FRAME_PULL_RECORDER_CHUNK_MINUTES=60
FRAME_PULL_RECORDER_MIN_FREE_SPACE_GB=20

# Per-job Linux overrides for Windows-bound values in the frozen config.
FRAME_PULL_LEGACY_TESSERACT_CMD=/usr/bin/tesseract
FRAME_PULL_LEGACY_FFMPEG_HWACCEL=
FRAME_PULL_LEGACY_EXAMPLES_DIR=/legacy/examples/manual_profile_screenshots

# Set a strong server-local value to authenticate the private bridge API.
FRAME_PULL_BRIDGE_TOKEN=
